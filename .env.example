# Copy this file to ".env" and fill in your own values. ".env" is in .gitignore. Never commit it.
# Export these variables before running rds_to_hdfs.py (on EMR: set them in the cluster / step environment).

# --- PostgreSQL on Amazon RDS (source database)
POSTGRES_HOST=<your-rds-endpoint>
POSTGRES_PORT=5432
SOURCE_DB=your_database_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
