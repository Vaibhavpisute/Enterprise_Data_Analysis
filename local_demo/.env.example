# Local demo settings. Copy this file to ".env" and change the values.
# ".env" is in .gitignore. Never commit it.

# --- PostgreSQL (database "sales_db" replaces Amazon RDS)
POSTGRES_USER=sales_admin
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SOURCE_DB=sales_db

# --- MinIO (replaces HDFS)
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=sales-data

# --- Airflow login for http://localhost:8081
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_password
AIRFLOW_SECRET_KEY=change_me_long_random_string

# --- Ports on your laptop (only reachable from this laptop)
POSTGRES_HOST_PORT=5433
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
AIRFLOW_HOST_PORT=8081

# --- Spark (local mode) - lower these if your laptop is slow
SPARK_DRIVER_MEMORY=1g
SPARK_LOCAL_CORES=2
